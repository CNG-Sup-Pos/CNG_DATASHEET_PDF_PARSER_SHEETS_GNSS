{
  "formatting_schema_version": "1.0",
  "description": "Output formatting specifications for Google Sheets integration and data presentation",
  "google_sheets_formatting": {
    "font_settings": {
      "family": "Arial",
      "size": 11,
      "header_size": 12,
      "header_bold": true
    },
    "column_settings": {
      "auto_resize": true,
      "minimum_width": 80,
      "maximum_width": 200,
      "text_wrap": true
    },
    "cell_formatting": {
      "borders": {
        "style": "solid",
        "color": "#cccccc",
        "weight": 1
      },
      "alignment": {
        "horizontal": "left",
        "vertical": "middle",
        "text_wrap": true
      }
    },
    "conditional_formatting": {
      "high_confidence": {
        "threshold": 85,
        "background_color": "#e8f5e8",
        "text_color": "#2e7d32"
      },
      "medium_confidence": {
        "threshold": 70,
        "background_color": "#fff3cd",
        "text_color": "#856404"
      },
      "low_confidence": {
        "threshold": 50,
        "background_color": "#f8d7da",
        "text_color": "#721c24"
      },
      "manual_override": {
        "background_color": "#d4edda",
        "text_color": "#155724",
        "italic": true
      }
    }
  },
  "field_specific_formatting": {
    "dimensions": {
      "format": "{length}×{width}×{height} mm",
      "precision": 1,
      "unit_required": true,
      "separator": "×",
      "validation": "Three numeric values with mm unit"
    },
    "weight": {
      "format": "{value} g",
      "precision": 1,
      "unit_required": true,
      "range_support": false,
      "validation": "Single numeric value with g unit"
    },
    "operating_temperature": {
      "format": "{min} to {max}°C",
      "precision": 1,
      "unit_required": true,
      "range_required": true,
      "separator": " to ",
      "validation": "Temperature range with °C unit"
    },
    "storage_temperature": {
      "format": "{min} to {max}°C",
      "precision": 1,
      "unit_required": true,
      "range_required": true,
      "separator": " to ",
      "validation": "Temperature range with °C unit"
    },
    "input_voltage": {
      "format": "{min}–{max} VDC",
      "precision": 1,
      "unit_required": true,
      "range_required": true,
      "separator": "–",
      "validation": "Voltage range with VDC unit"
    },
    "power_consumption": {
      "format": "{value} W",
      "precision": 2,
      "unit_required": true,
      "range_support": false,
      "qualifiers": ["Typical", "Maximum", "Standby"],
      "validation": "Power value with W unit"
    },
    "imu": {
      "format": "Gyro: {gyro_spec}, Accel: {accel_spec}",
      "structure_required": true,
      "components": ["gyroscope", "accelerometer"],
      "not_available_text": "Not available",
      "validation": "Structured IMU specifications or 'Not available'"
    },
    "accuracy": {
      "format": "{horizontal} cm + {scale} ppm",
      "precision": 2,
      "components": ["horizontal", "scale"],
      "unit_required": true,
      "qualifier_support": ["Horizontal", "Vertical", "3D"],
      "validation": "Accuracy with cm and ppm components"
    },
    "latency": {
      "format": "{value} {unit}",
      "precision": 1,
      "allowed_units": ["ms", "Hz"],
      "conversion_rules": {
        "Hz_to_ms": "1000 / frequency",
        "ms_to_Hz": "1000 / latency"
      },
      "validation": "Timing specification with ms or Hz unit"
    },
    "frequency": {
      "format": "{frequency_list}",
      "separator": ", ",
      "standard_notation": ["L1", "L2", "L5", "G1", "G2", "E1", "E5", "B1", "B2"],
      "grouping": "by_constellation",
      "validation": "Comma-separated frequency list"
    },
    "ip_rating": {
      "format": "IP{dust}{water}",
      "validation_pattern": "^IP[0-6][0-8]$",
      "explanation_support": true,
      "common_ratings": {
        "IP65": "Dust tight, water jet protection",
        "IP67": "Dust tight, temporary immersion",
        "IP68": "Dust tight, continuous immersion"
      },
      "validation": "Standard IP rating format"
    },
    "channels": {
      "format": "{count} channels",
      "precision": 0,
      "range_support": true,
      "range_format": "{min}-{max} channels",
      "suffix_required": true,
      "validation": "Channel count with 'channels' suffix"
    },
    "constellations": {
      "format": "{constellation_list}",
      "separator": ", ",
      "standard_names": ["GPS", "GLONASS", "Galileo", "BeiDou", "QZSS", "IRNSS"],
      "abbreviation_support": true,
      "validation": "Comma-separated constellation list"
    },
    "interfaces": {
      "format": "{interface_list}",
      "separator": ", ",
      "standard_names": ["Ethernet", "USB", "RS232", "RS422", "CAN", "Wi-Fi", "Bluetooth"],
      "qualifier_support": true,
      "qualifiers": ["10/100", "USB 2.0", "CAN-FD"],
      "validation": "Comma-separated interface list"
    },
    "formats": {
      "format": "{format_list}",
      "separator": ", ",
      "standard_formats": ["RTCM", "RINEX", "NMEA", "UBX", "SBF"],
      "version_support": true,
      "version_format": "{format} v{version}",
      "validation": "Comma-separated format list"
    },
    "warranty": {
      "format": "{duration} {terms}",
      "duration_required": true,
      "terms_optional": true,
      "standard_durations": ["1 year", "2 years", "3 years"],
      "validation": "Warranty duration with optional terms"
    },
    "time_sync": {
      "format": "{sync_method}",
      "standard_methods": ["GPS time", "UTC", "PPS output", "GNSS time"],
      "not_available_text": "Not available",
      "precision_support": true,
      "validation": "Time synchronization method"
    },
    "measurement_types": {
      "format": "{type_list}",
      "separator": ", ",
      "standard_types": ["RTK", "PPP", "DGPS", "SBAS", "Standalone"],
      "accuracy_association": true,
      "validation": "Comma-separated measurement type list"
    },
    "firmware_options": {
      "format": "{option_list}",
      "separator": ", ",
      "structure_support": true,
      "option_format": "{name} ({description})",
      "not_available_text": "Standard only",
      "validation": "Firmware options with optional descriptions"
    }
  },
  "data_quality_formatting": {
    "confidence_display": {
      "show_confidence": true,
      "confidence_format": " (Confidence: {score}%)",
      "confidence_colors": {
        "high": "#2e7d32",
        "medium": "#f57c00",
        "low": "#d32f2f"
      },
      "hide_threshold": 95
    },
    "validation_indicators": {
      "show_validation_status": true,
      "validation_symbols": {
        "pass": "✓",
        "fail": "✗",
        "warning": "⚠",
        "manual": "✎"
      },
      "symbol_colors": {
        "pass": "#4caf50",
        "fail": "#f44336",
        "warning": "#ff9800",
        "manual": "#2196f3"
      }
    },
    "error_handling": {
      "extraction_failed": "EXTRACTION_FAILED",
      "validation_failed": "VALIDATION_FAILED",
      "format_error": "FORMAT_ERROR",
      "manual_required": "MANUAL_REVIEW_REQUIRED"
    }
  },
  "export_formats": {
    "csv_export": {
      "delimiter": ",",
      "quote_character": "\"",
      "escape_sequences": true,
      "header_row": true,
      "encoding": "UTF-8"
    },
    "json_export": {
      "indent": 2,
      "sort_keys": true,
      "ensure_ascii": false,
      "include_metadata": true
    },
    "xml_export": {
      "root_element": "gnss_devices",
      "device_element": "device",
      "attribute_mapping": "field_to_attribute",
      "include_schema": true
    }
  },
  "localization": {
    "supported_locales": ["en-US", "en-GB"],
    "date_formats": {
      "en-US": "MM/dd/yyyy",
      "en-GB": "dd/MM/yyyy"
    },
    "number_formats": {
      "decimal_separator": ".",
      "thousands_separator": ",",
      "currency_symbol": "$"
    },
    "unit_conversions": {
      "temperature": {
        "celsius_to_fahrenheit": "(°C × 9/5) + 32",
        "fahrenheit_to_celsius": "(°F - 32) × 5/9"
      },
      "weight": {
        "grams_to_ounces": "g ÷ 28.35",
        "ounces_to_grams": "oz × 28.35"
      },
      "dimensions": {
        "mm_to_inches": "mm ÷ 25.4",
        "inches_to_mm": "in × 25.4"
      }
    }
  },
  "presentation_templates": {
    "summary_report": {
      "title": "GNSS Device Specifications Summary",
      "sections": [
        "device_identification",
        "physical_specifications",
        "electrical_specifications",
        "performance_specifications",
        "connectivity_options",
        "warranty_information"
      ],
      "formatting": "professional_table"
    },
    "comparison_table": {
      "title": "GNSS Device Comparison",
      "orientation": "horizontal",
      "highlight_differences": true,
      "group_by_category": true,
      "include_confidence": false
    },
    "technical_datasheet": {
      "title": "Technical Specifications",
      "detailed_format": true,
      "include_extraction_notes": true,
      "include_confidence_scores": true,
      "include_source_references": true
    }
  }
}
