{
  "validation_schema_version": "1.0",
  "description": "Comprehensive validation rules for all 18 GNSS parser fields",
  "global_validation": {
    "required_confidence_minimum": 50,
    "auto_reject_below": 30,
    "manual_review_threshold": 70,
    "high_confidence_threshold": 85,
    "maximum_field_length": 500,
    "allowed_characters": "alphanumeric, spaces, standard punctuation, units symbols"
  },
  "field_validation_rules": {
    "dimensions": {
      "required": true,
      "format_pattern": "^\\d+(?:\\.\\d+)?\\s*[×x]\\s*\\d+(?:\\.\\d+)?\\s*[×x]\\s*\\d+(?:\\.\\d+)?\\s*mm$",
      "value_ranges": {
        "length_mm": {"min": 10, "max": 500},
        "width_mm": {"min": 10, "max": 500},
        "height_mm": {"min": 5, "max": 200}
      },
      "validation_rules": [
        "Must contain three numeric dimensions",
        "Must use × or x as separator",
        "Must include mm unit specification",
        "Dimensions must be physically reasonable for GNSS devices"
      ],
      "common_errors": ["Missing units", "Two dimensions only", "Inconsistent separators"],
      "rejection_criteria": ["Zero or negative dimensions", "Unrealistic size (>500mm any dimension)"]
    },
    "weight": {
      "required": true,
      "format_pattern": "^\\d+(?:\\.\\d+)?\\s*g$",
      "value_ranges": {
        "weight_g": {"min": 5, "max": 5000}
      },
      "validation_rules": [
        "Must be numeric value with g unit",
        "Weight must be reasonable for device size",
        "No shipping or packaging weight"
      ],
      "common_errors": ["Missing g unit", "Including packaging weight", "Kg instead of g"],
      "rejection_criteria": ["Weight > 5kg (likely packaging)", "Weight < 5g (unrealistic)"]
    },
    "operating_temperature": {
      "required": true,
      "format_pattern": "^-?\\d+(?:\\.\\d+)?\\s*to\\s*\\+?\\d+(?:\\.\\d+)?°C$",
      "value_ranges": {
        "min_temp_c": {"min": -60, "max": 10},
        "max_temp_c": {"min": 40, "max": 100}
      },
      "validation_rules": [
        "Must specify temperature range with 'to' separator",
        "Must include °C unit",
        "Minimum must be less than maximum",
        "Range must be reasonable for electronics"
      ],
      "common_errors": ["Single temperature value", "Missing °C", "Fahrenheit units"],
      "rejection_criteria": ["Min > Max temperature", "Range outside -60°C to +100°C"]
    },
    "storage_temperature": {
      "required": true,
      "format_pattern": "^-?\\d+(?:\\.\\d+)?\\s*to\\s*\\+?\\d+(?:\\.\\d+)?°C$",
      "value_ranges": {
        "min_temp_c": {"min": -80, "max": 0},
        "max_temp_c": {"min": 50, "max": 120}
      },
      "validation_rules": [
        "Storage range should be wider than operating range",
        "Must follow same format as operating temperature",
        "Should allow for shipping conditions"
      ],
      "cross_field_validation": {
        "related_field": "operating_temperature",
        "rule": "Storage range should encompass operating range"
      }
    },
    "input_voltage": {
      "required": true,
      "format_pattern": "^\\d+(?:\\.\\d+)?–\\d+(?:\\.\\d+)?\\s*VDC$",
      "value_ranges": {
        "min_voltage": {"min": 3.3, "max": 24},
        "max_voltage": {"min": 5, "max": 48}
      },
      "validation_rules": [
        "Must specify voltage range with – separator",
        "Must include VDC unit (DC voltage)",
        "Range should be suitable for electronic devices",
        "Common ranges: 3.3-5V, 9-32V, 12-24V"
      ],
      "common_errors": ["VAC instead of VDC", "Single voltage value", "Missing units"],
      "rejection_criteria": ["AC voltage specifications", "Voltage > 48V", "Min > Max"]
    },
    "power_consumption": {
      "required": true,
      "format_pattern": "^\\d+(?:\\.\\d+)?\\s*W$",
      "value_ranges": {
        "power_w": {"min": 0.1, "max": 50}
      },
      "validation_rules": [
        "Must specify power in Watts",
        "Should represent typical operating power",
        "Must be reasonable for device size and type"
      ],
      "cross_field_validation": {
        "related_field": "input_voltage",
        "rule": "Power should be consistent with voltage range"
      },
      "common_errors": ["mW units not converted", "Maximum instead of typical power"],
      "rejection_criteria": ["Power > 50W (unrealistic for GNSS)", "Power < 0.1W (too low)"]
    },
    "imu": {
      "required": false,
      "format_pattern": ".*[Gg]yro.*[Aa]ccel.*",
      "validation_rules": [
        "Must mention both gyroscope and accelerometer if present",
        "Should include specifications or ranges",
        "Can be 'Not available' or 'External required'"
      ],
      "accepted_values": ["Specifications present", "Not available", "External IMU", "Optional feature"],
      "common_errors": ["Only gyro or accel mentioned", "Unclear specifications"]
    },
    "accuracy": {
      "required": true,
      "format_pattern": "^\\d+(?:\\.\\d+)?\\s*cm.*ppm.*",
      "value_ranges": {
        "horizontal_accuracy_cm": {"min": 0.1, "max": 500},
        "vertical_accuracy_cm": {"min": 0.1, "max": 1000}
      },
      "validation_rules": [
        "Must include horizontal accuracy in cm",
        "Should include ppm component for scale",
        "Should specify RTK vs standalone accuracy",
        "Must be realistic for GNSS technology"
      ],
      "common_errors": ["Missing ppm component", "Mixing RTK and standalone specs"],
      "rejection_criteria": ["Accuracy > 500cm horizontal", "Missing units"]
    },
    "latency": {
      "required": true,
      "format_pattern": "^\\d+(?:\\.\\d+)?\\s*(ms|Hz)$",
      "value_ranges": {
        "latency_ms": {"min": 1, "max": 1000},
        "update_rate_hz": {"min": 1, "max": 1000}
      },
      "validation_rules": [
        "Can be specified as latency (ms) or update rate (Hz)",
        "Must be reasonable for real-time applications",
        "Should match device processing capabilities"
      ],
      "common_errors": ["Mixing ms and Hz in same value", "Unrealistic values"],
      "rejection_criteria": ["Latency > 1000ms", "Update rate > 1000Hz"]
    },
    "frequency": {
      "required": true,
      "format_pattern": ".*[LlGg][12345].*",
      "validation_rules": [
        "Must list supported GNSS frequencies",
        "Should use standard notation (L1, L2, L5, G1, G2, etc.)",
        "Should be comma-separated list",
        "Must be realistic for current GNSS technology"
      ],
      "standard_frequencies": ["L1", "L2", "L5", "G1", "G2", "E1", "E5", "B1", "B2"],
      "common_errors": ["Non-standard frequency notation", "Missing frequency designations"],
      "rejection_criteria": ["No recognizable frequencies", "Invalid frequency designations"]
    },
    "ip_rating": {
      "required": true,
      "format_pattern": "^IP\\d{2}$",
      "value_ranges": {
        "dust_protection": {"min": 0, "max": 6},
        "water_protection": {"min": 0, "max": 8}
      },
      "validation_rules": [
        "Must follow IP rating standard (IP followed by two digits)",
        "First digit: dust protection (0-6)",
        "Second digit: water protection (0-8)",
        "Should be appropriate for outdoor GNSS use"
      ],
      "common_ratings": ["IP65", "IP66", "IP67", "IP68"],
      "rejection_criteria": ["Invalid IP format", "Unrealistic protection levels"]
    },
    "channels": {
      "required": true,
      "format_pattern": "^\\d+(?:-\\d+)?(?:\\s*channels?)?$",
      "value_ranges": {
        "channel_count": {"min": 12, "max": 800}
      },
      "validation_rules": [
        "Must specify number of tracking channels",
        "Can be single number or range",
        "Should be realistic for GNSS receiver technology",
        "Modern receivers typically have 100+ channels"
      ],
      "common_errors": ["Confusing with satellites", "Unrealistic low numbers"],
      "rejection_criteria": ["Channels < 12 (too low)", "Channels > 800 (unrealistic)"]
    },
    "constellations": {
      "required": true,
      "format_pattern": ".*(GPS|GLONASS|Galileo|BeiDou).*",
      "validation_rules": [
        "Must list supported GNSS constellations",
        "Should use standard names",
        "Should be comma-separated",
        "Must include at least GPS for modern receivers"
      ],
      "standard_constellations": ["GPS", "GLONASS", "Galileo", "BeiDou", "QZSS", "IRNSS"],
      "required_constellations": ["GPS"],
      "rejection_criteria": ["No GPS support", "Invalid constellation names"]
    },
    "interfaces": {
      "required": true,
      "format_pattern": ".*(Ethernet|USB|RS232|CAN).*",
      "validation_rules": [
        "Must list available communication interfaces",
        "Should use standard interface names",
        "Should be comma-separated",
        "Must include at least one modern interface"
      ],
      "standard_interfaces": ["Ethernet", "USB", "RS232", "RS422", "CAN", "Wi-Fi", "Bluetooth"],
      "common_errors": ["Proprietary interface names", "Missing modern interfaces"],
      "rejection_criteria": ["No standard interfaces", "Legacy interfaces only"]
    },
    "formats": {
      "required": true,
      "format_pattern": ".*(RTCM|RINEX|NMEA).*",
      "validation_rules": [
        "Must list supported data output formats",
        "Should include industry standards",
        "Should be comma-separated",
        "Must support real-time applications"
      ],
      "standard_formats": ["RTCM", "RINEX", "NMEA", "UBX", "SBF", "BINEX"],
      "required_formats": ["RTCM"],
      "rejection_criteria": ["No RTCM support", "Proprietary formats only"]
    },
    "warranty": {
      "required": true,
      "format_pattern": ".*\\d+.*year.*",
      "value_ranges": {
        "warranty_years": {"min": 1, "max": 10}
      },
      "validation_rules": [
        "Must specify warranty duration",
        "Should include terms or conditions",
        "Duration should be reasonable for electronics",
        "Should be clearly stated timeframe"
      ],
      "common_errors": ["Missing duration", "Unclear terms", "Warranty conditions only"],
      "rejection_criteria": ["No time specification", "Warranty > 10 years"]
    },
    "time_sync": {
      "required": false,
      "format_pattern": ".*(PPS|GPS|UTC|TAI).*",
      "validation_rules": [
        "Should specify time synchronization method",
        "Can include PPS output capabilities",
        "Should reference time standard (GPS, UTC)",
        "Can be 'Not available' for basic units"
      ],
      "standard_references": ["GPS time", "UTC", "TAI", "PPS", "GNSS time"],
      "common_errors": ["Unclear time reference", "Missing synchronization method"]
    },
    "measurement_types": {
      "required": true,
      "format_pattern": ".*(RTK|PPP|DGPS).*",
      "validation_rules": [
        "Must specify supported positioning methods",
        "Should include accuracy enhancement capabilities",
        "Should be comma-separated list",
        "Must be realistic for device class"
      ],
      "standard_types": ["RTK", "PPP", "DGPS", "SBAS", "Standalone"],
      "required_types": ["Standalone"],
      "rejection_criteria": ["No positioning methods", "Invalid method names"]
    },
    "firmware_options": {
      "required": false,
      "format_pattern": ".*(Pro|Base|Standard).*",
      "validation_rules": [
        "Should list available firmware variants",
        "Can include feature descriptions",
        "Should indicate upgrade paths",
        "Can be 'Standard only' for single-option devices"
      ],
      "common_variants": ["Pro", "Professional", "Base", "Standard", "Extended", "RTK"],
      "common_errors": ["Unclear variant names", "Missing feature descriptions"]
    }
  },
  "cross_field_validation": {
    "power_voltage_consistency": {
      "description": "Validate power consumption is reasonable for voltage range",
      "fields": ["power_consumption", "input_voltage"],
      "validation_logic": "power_watts < (max_voltage * 3) for reasonable current draw"
    },
    "temperature_consistency": {
      "description": "Storage temperature should encompass operating temperature",
      "fields": ["operating_temperature", "storage_temperature"],
      "validation_logic": "storage_min <= operating_min AND storage_max >= operating_max"
    },
    "accuracy_method_consistency": {
      "description": "Accuracy should match supported measurement methods",
      "fields": ["accuracy", "measurement_types"],
      "validation_logic": "RTK accuracy requires RTK capability"
    },
    "interface_format_consistency": {
      "description": "Data formats should match interface capabilities",
      "fields": ["interfaces", "formats"],
      "validation_logic": "Real-time formats require appropriate interfaces"
    }
  },
  "quality_metrics": {
    "field_completeness": "Percentage of required fields successfully extracted",
    "format_compliance": "Percentage of fields matching expected patterns",
    "cross_validation_success": "Percentage of cross-field validations passing",
    "confidence_distribution": "Distribution of confidence scores across fields",
    "manual_override_rate": "Percentage of fields requiring manual correction"
  },
  "reporting": {
    "validation_summary": "Overall validation pass/fail status",
    "field_level_results": "Individual field validation outcomes",
    "error_details": "Specific validation failures and recommendations",
    "quality_score": "Composite quality metric (0-100)",
    "manual_review_flags": "Fields requiring human verification"
  }
}
